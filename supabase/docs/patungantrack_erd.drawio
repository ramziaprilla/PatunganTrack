<mxfile host="app.diagrams.net">
  <diagram id="patungantrack-erd" name="ERD PatunganTrack">
    <mxGraphModel dx="1300" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="ERD PatunganTrack (Supabase / PostgreSQL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- ENTITAS 1: auth.users -->
        <mxCell id="auth" value="auth.users (bawaan Supabase Auth)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="300" height="82" as="geometry" />
        </mxCell>
        <mxCell id="auth_1" value="PK    id : uuid" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontStyle=1;" vertex="1" parent="auth">
          <mxGeometry y="30" width="300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="auth_2" value="       email : text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="auth">
          <mxGeometry y="56" width="300" height="26" as="geometry" />
        </mxCell>

        <!-- ENTITAS 2: kegiatan -->
        <mxCell id="kegiatan" value="kegiatan" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="keg_1" value="PK    id : bigint (identity)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontStyle=1;" vertex="1" parent="kegiatan">
          <mxGeometry y="30" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="keg_2" value="       created_at : timestamptz (default now())" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="kegiatan">
          <mxGeometry y="56" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="keg_3" value="       nama_kegiatan : text (NOT NULL, tidak kosong)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="kegiatan">
          <mxGeometry y="82" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="keg_4" value="       total_biaya : numeric(14,2) (default 0, &gt;= 0)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="kegiatan">
          <mxGeometry y="108" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="keg_5" value="FK    user_id : uuid (NOT NULL, default auth.uid())" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontStyle=2;" vertex="1" parent="kegiatan">
          <mxGeometry y="134" width="320" height="26" as="geometry" />
        </mxCell>

        <!-- ENTITAS 3: peserta -->
        <mxCell id="peserta" value="peserta" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="77" width="320" height="186" as="geometry" />
        </mxCell>
        <mxCell id="pes_1" value="PK    id : bigint (identity)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontStyle=1;" vertex="1" parent="peserta">
          <mxGeometry y="30" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pes_2" value="FK    kegiatan_id : bigint (NOT NULL, ON DELETE CASCADE)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontStyle=2;" vertex="1" parent="peserta">
          <mxGeometry y="56" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pes_3" value="       nama_peserta : text (NOT NULL, tidak kosong)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="peserta">
          <mxGeometry y="82" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pes_4" value="       nominal_tagihan : numeric(14,2) (default 0, &gt;= 0)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="peserta">
          <mxGeometry y="108" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pes_5" value="       status_lunas : boolean (default false)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="peserta">
          <mxGeometry y="134" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pes_6" value="       created_at : timestamptz (default now())" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;" vertex="1" parent="peserta">
          <mxGeometry y="160" width="320" height="26" as="geometry" />
        </mxCell>

        <!-- RELASI -->
        <mxCell id="rel1" value="membuat" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeWidth=2;" edge="1" parent="1" source="auth" target="kegiatan">
          <mxGeometry width="100" height="100" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel2" value="memiliki" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeWidth=2;" edge="1" parent="1" source="kegiatan" target="peserta">
          <mxGeometry width="100" height="100" relative="1" as="geometry" />
        </mxCell>

        <!-- LEGENDA -->
        <mxCell id="legend" value="Keterangan: PK = Primary Key, FK = Foreign Key. Relasi 1 ke banyak (notasi crow's foot): satu user membuat banyak kegiatan, satu kegiatan memiliki banyak peserta." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="760" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
